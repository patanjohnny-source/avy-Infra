        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(projectId) && isValidProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'location', 'placeId', 'clientName', 'status', 'startDate', 'finishDate', 'managerName', 'managerPhone', 'engineerName', 'engineerPhone', 'updatedAt']);
      allow delete: if isValidId(projectId) && isOwnerResource();
    }

    match /towers/{towerId} {
      allow get: if isValidId(towerId) && isOwnerResource();
