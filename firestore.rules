        && ownsDoc('projects', incoming().projectId);
      allow update: if isVerified() && isValidId(expenseId) && isValidSiteExpense(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'projectId', 'projectName', 'towerId', 'towerName', 'category', 'customCategory', 'description', 'vendorName', 'amount', 'paymentMode', 'paymentApp', 'transactionId', 'upiId', 'proofImageDataUrl', 'notes', 'recordedByRole', 'recordedByName', 'recordedByEmployeeId', 'toolItemsSummary', 'billReceiptNumber', 'reimbursementStatus', 'updatedAt']);
      allow delete: if isValidId(expenseId) && isOwnerResource();
    }

    match /settlements/{settlementId} {
      allow get: if isValidId(settlementId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(settlementId) && isValidSettlement(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsDoc('employees', incoming().employeeId);
      allow update: if false;
      allow delete: if isValidId(settlementId) && isOwnerResource();
    }

    match /qr_passes/{passId} {
      allow get: if isValidId(passId) && passId.size() >= 16;
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(passId) && passId.size() >= 16 && isValidQrPass(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsDoc('employees', incoming().employeeId);
      allow update: if isVerified() && isValidId(passId) && passId.size() >= 16 && isValidQrPass(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().employeeId == existing().employeeId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['empCode', 'fullName', 'role', 'status', 'companyName', 'joiningDate', 'currentProjectName', 'currentTowerName', 'deployedSince', 'todayAttendanceStatus', 'todayAttendanceDate', 'completedZonesCount', 'activeAssignments', 'recentDeployments', 'updatedAt']);
      allow delete: if isValidId(passId) && isOwnerResource();
    }

    match /site_logs/{logId} {
      allow get: if isValidId(logId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(logId) && isValidDailySiteLog(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && ownsDoc('projects', incoming().projectId)
        && ownsDoc('towers', incoming().towerId);
      allow update: if isVerified() && isValidId(logId) && isValidDailySiteLog(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().projectId == existing().projectId
        && incoming().towerId == existing().towerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'notes', 'photoDataUrl', 'updatedAt']);
      allow delete: if isValidId(logId) && isOwnerResource();
    }

    match /billing_docs/{docId} {
      allow get: if isValidId(docId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(docId) && isValidBillingDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('projectId' in incoming()) || incoming().projectId == '' || ownsDoc('projects', incoming().projectId));
      allow update: if isVerified() && isValidId(docId) && isValidBillingDocument(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['docType', 'docNumber', 'issueDate', 'dueDate', 'projectId', 'projectName', 'towerId', 'towerName', 'clientName', 'clientPhone', 'clientEmail', 'clientAddress', 'clientGstin', 'placeOfSupply', 'taxMode', 'items', 'subtotal', 'cgstTotal', 'sgstTotal', 'igstTotal', 'roundOff', 'grandTotal', 'amountPaid', 'status', 'notes', 'terms', 'whatsappShared', 'useCustomLetterhead', 'hideDefaultHeader', 'letterheadBgDataUrl', 'letterheadBgOpacity', 'updatedAt']);
      allow delete: if isValidId(docId) && isOwnerResource();
    }

    match /company_documents/{docId} {
      allow get: if isValidId(docId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(docId) && isValidCompanyDocument(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (!('employeeId' in incoming()) || incoming().employeeId == '' || ownsDoc('employees', incoming().employeeId));
      allow update: if isVerified() && isValidId(docId) && isValidCompanyDocument(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (!('employeeId' in incoming()) || incoming().employeeId == '' || ownsDoc('employees', incoming().employeeId))
        && incoming().diff(existing()).affectedKeys().hasOnly(['source', 'docCategory', 'fileFormat', 'title', 'fileName', 'mimeType', 'sizeBytes', 'approvalStatus', 'approvedByName', 'approvedAt', 'employeeId', 'empCode', 'employeeName', 'refNumber', 'issueDate', 'recipient', 'subject', 'bodyHtml', 'plainTextSummary', 'deckJson', 'dataUrl', 'updatedAt']);
      allow delete: if isValidId(docId) && isOwnerResource();
    }

    match /team_messages/{messageId} {
      allow get: if isValidId(messageId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(messageId) && isValidTeamMessage(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(messageId) && isValidTeamMessage(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['readByIds', 'updatedAt']);
      allow delete: if isValidId(messageId) && isOwnerResource();
    }
  }
}
