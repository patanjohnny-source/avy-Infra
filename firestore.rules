        && (!('towerId' in data) || isValidString(data.towerId, 0, 128))
        && (!('towerName' in data) || isValidString(data.towerName, 0, 80))
        && isValidString(data.senderId, 1, 128)
        && isValidString(data.senderName, 1, 100)
        && data.senderRole in ['admin', 'supervisor', 'employee']
        && (!('recipientId' in data) || isValidString(data.recipientId, 0, 128))
        && (!('recipientName' in data) || isValidString(data.recipientName, 0, 100))
        && (!('recipientRole' in data) || data.recipientRole in ['admin', 'supervisor', 'employee'])
        && isValidString(data.body, 1, 1200)
        && (!('attachmentName' in data) || isValidString(data.attachmentName, 0, 180))
        && (!('attachmentMimeType' in data) || isValidString(data.attachmentMimeType, 0, 120))
        && (!('attachmentDataUrl' in data) || isValidString(data.attachmentDataUrl, 0, 340000))
        && data.readByIds is list && data.readByIds.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // --- Collection Rules ---

    match /company_profiles/{profileId} {
      allow get: if isValidId(profileId) && isOwnerResource();
      allow list: if isVerified() && resource.data.ownerId == request.auth.uid;
      allow create: if isVerified() && isValidId(profileId) && isValidCompanyProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidId(profileId) && isValidCompanyProfile(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['companyName', 'tagline', 'address', 'hrContact', 'hrEmail', 'gstNumber', 'pfEstCode', 'esiCode', 'signatoryName', 'logoDataUrl', 'requireFinishBeforeNewWork', 'adminUsername', 'adminPassword', 'adminEditPin', 'supervisorCanEditAttendance', 'customAdvanceCategories', 'customExpenseCategories', 'weeklyExpenseBudget', 'idCardFrontBgDataUrl', 'idCardBackBgDataUrl', 'idCardBgColor', 'idCardHeaderColor', 'idCardAccentColor', 'idCardTextColor', 'idCardBgOpacity', 'quotationLetterheadBgDataUrl', 'quotationLetterheadOpacity', 'tileZoneCatalog', 'updatedAt']);
