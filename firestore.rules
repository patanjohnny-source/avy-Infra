        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'advanceType', 'amount', 'paymentMode', 'projectId', 'projectName', 'towerId', 'towerName', 'isSundayRun', 'whatsappShared', 'acknowledged', 'acknowledgedAt', 'acknowledgedBy', 'followUpSentAt', 'followUpCount', 'approvalStatus', 'approvalBatchId', 'submittedByName', 'submittedByRole', 'approvedByName', 'approvedAt', 'approvalNote', 'notes', 'customCategory', 'paymentApp', 'transactionId', 'upiId', 'proofImageDataUrl', 'updatedAt']);
