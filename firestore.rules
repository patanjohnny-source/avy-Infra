        && incoming().employeeId == existing().employeeId
        && incoming().date == existing().date
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'inTime', 'outTime', 'overtimeHours', 'dailyWageEarned', 'overtimePayEarned', 'projectId', 'projectName', 'towerId', 'towerName', 'notes', 'markedByRole', 'markedByName', 'editedByName', 'editedAt', 'editReason', 'updatedAt']);
