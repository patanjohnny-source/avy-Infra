  "firestore": {
    "/company_profiles/{profileId}": {
      "schema": { "$ref": "#/entities/CompanyProfile" },
      "description": "Company profile details, HR contacts, and customizable tile area catalog."
    },
    "/projects/{projectId}": {
      "schema": { "$ref": "#/entities/Project" },
      "description": "Projects with timeline dates and manager/engineer contacts."
    },
    "/towers/{towerId}": {
      "schema": { "$ref": "#/entities/Tower" },
      "description": "Towers with timeline dates and tower incharge/supervisor/engineer/manager contacts."
    },
    "/flats/{flatId}": {
      "schema": { "$ref": "#/entities/FlatUnit" },
      "description": "Individual flats and special levels with customizable tile-laying area states."
    },
    "/employees/{employeeId}": {
      "schema": { "$ref": "#/entities/Employee" },
      "description": "Employee master records with photo, PF/ESI, Aadhar, blood group, contacts, and site location."
    },
    "/employee_docs/{docId}": {
      "schema": { "$ref": "#/entities/EmployeeDocument" },
      "description": "Uploaded Aadhar PDF and supporting documents per employee."
    },
    "/employee_backups/{backupId}": {
      "schema": { "$ref": "#/entities/EmployeeBackup" },
      "description": "Automatic archived backups created whenever an employee is removed from Workforce & IDs."
    },
    "/deployments/{deploymentId}": {
      "schema": { "$ref": "#/entities/DeploymentRecord" },
      "description": "Cross-project and tower crew deployment history."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/WorkAssignment" },
      "description": "Flat & room tile-laying assignment history."
    },
    "/attendance/{attendanceId}": {
      "schema": { "$ref": "#/entities/AttendanceRecord" },
      "description": "Daily attendance records per employee, project, and tower."
    },
    "/advances/{advanceId}": {
      "schema": { "$ref": "#/entities/AdvanceEntry" },
      "description": "Daily food, Sunday weekly food, and cash advance disbursements by project/tower."
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/SiteExpense" },
      "description": "Project-wise and tower-wise operational expenses."
    },
    "/settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/SettlementEntry" },
      "description": "Payroll settlement history."
    },
    "/qr_passes/{passId}": {
      "schema": { "$ref": "#/entities/QrPass" },
      "description": "Publicly scannable non-PII workforce QR verification passes keyed by an unguessable pass token."
    },
    "/site_logs/{logId}": {
      "schema": { "$ref": "#/entities/DailySiteLog" },
      "description": "Daily tower progress logs and optional photo captures by supervisors and admin."
    },
    "/billing_docs/{docId}": {
      "schema": { "$ref": "#/entities/BillingDocument" },
      "description": "Saved Quotations, Invoices, and Project-wise GST Tax Invoices."
    },
    "/company_documents/{docId}": {
      "schema": { "$ref": "#/entities/CompanyDocument" },
      "description": "Documents Drive storing generated Smart Employee Letters, Word letterheads, PowerPoint decks, and uploaded Office/PDF files."
    },
    "/team_messages/{messageId}": {
      "schema": { "$ref": "#/entities/TeamMessage" },
      "description": "In-app team messenger threads for Admin, Supervisors, and Employees."
    }
  }
}
